{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vostok Quartermaster",
  "version": "0.1.0",
  "identifier": "com.pr0gorib.vostokquartermaster",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Vostok Quartermaster",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
